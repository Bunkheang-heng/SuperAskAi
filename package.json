{
  "name": "askgov",
  "version": "0.1.0",
  "private": true,
  "description": "AskGov (askgov.kh) — National Citizen Information Assistant. Phase 0 prototype.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "eval": "tsx scripts/eval.ts",
    "smoke": "tsx scripts/provider-smoke.ts",
    "verify-check": "tsx scripts/verify-check.ts",
    "curated-check": "tsx scripts/curated-check.ts",
    "scope-check": "tsx scripts/scope-check.ts",
    "rationale-check": "tsx scripts/rationale-check.ts",
    "build-sources": "tsx scripts/build-sources.ts",
    "crawl:verify": "tsx scripts/crawl.ts --mode=verify",
    "crawl:monitor": "tsx scripts/crawl.ts --mode=monitor",
    "crawl:weekly": "tsx scripts/crawl.ts --mode=monitor --priority=1,2",
    "check": "npm run typecheck && npm run eval && npm run verify-check && npm run curated-check && npm run scope-check && npm run rationale-check"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.0",
    "lucide-react": "^0.469.0",
    "next": "^15.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}
