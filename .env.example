# AskGov â€” environment template. Copy to .env.local and fill in.
# .env.local is gitignored. Never commit a real key (R-15, FR-74).

# ---------------------------------------------------------------------------
# Model provider (NFR-18). One of: anthropic | vllm | extractive
#   anthropic  â€” Phase 0. Commercial API, external hosting (RD-01).
#   vllm       â€” Phase 1 target. Self-hosted Qwen behind an OpenAI-compatible
#                endpoint on DGC infrastructure (RD-02).
#   extractive â€” No model. Deterministic extraction from retrieved sources.
#                Used when no credential is present, and as the NFR-09
#                degradation path.
# ---------------------------------------------------------------------------
LLM_PROVIDER=anthropic

# --- anthropic provider ----------------------------------------------------
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5
# Set only when routing through a gateway or proxy rather than
# api.anthropic.com. A key that does not begin with `sk-ant-` needs this.
ANTHROPIC_BASE_URL=

# --- vllm provider (Phase 1) ----------------------------------------------
VLLM_BASE_URL=http://inference.internal.dgc:8000/v1
VLLM_MODEL=qwen3-32b-instruct
VLLM_API_KEY=

# ---------------------------------------------------------------------------
# Thresholds. Governance-owned, not engineering discretion (section 12).
# ---------------------------------------------------------------------------
# Tier 1 curated-answer match confidence required to serve verbatim (FR-11).
CURATED_MATCH_THRESHOLD=0.72
# Minimum fused retrieval score to attempt generation. Below this: escalate
# rather than guess (FR-16). Derived from the sweep printed by `npm run eval`.
RETRIEVAL_MIN_SCORE=0.20

# Diagnostic view (FR-72/FR-73). Citizens must never see this.
# Phase 0 closed pilot: DGC and ministry staff only.
DIAGNOSTICS_ENABLED=true
